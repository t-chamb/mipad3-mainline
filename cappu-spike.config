# Mi Pad 3 mainline boot spike. Apply on top of arm64 defconfig:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/defconfig cappu-spike.config
# Keep the Image at most 28 MB: the stock LK gunzips the kernel to 0x40080000 with a
# 0x1c00000 output limit and hangs if it is exceeded. See the platform list at the end.

CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT8173=y
CONFIG_PINCTRL_MT8173=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MTK_INFRACFG=y
CONFIG_MTK_SCPSYS_PM_DOMAINS=y
CONFIG_MFD_MT6397=y
CONFIG_PINCTRL_MT6397=y
CONFIG_REGULATOR_MT6397=y
CONFIG_REGULATOR_DA9211=y
CONFIG_RTC_DRV_MT6397=y
CONFIG_KEYBOARD_MTK_PMIC=y
CONFIG_KEYBOARD_MT6779=y
CONFIG_I2C_MT65XX=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_MMC_MTK=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# Console on the bootloader's framebuffer through the legacy simplefb driver: it draws
# each console line straight into the scanned-out memory. simpledrm draws into a shadow
# buffer flushed by a deferred worker, so a hard hang right after its first clear leaves
# a black screen (first spike boot, 2026-11-21). The MediaTek DRM driver would reset the
# display.
CONFIG_DRM=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# logs from a failed boot survive in RAM at 0x44400000
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# USB peripheral. g_serial is built in so the kernel console reaches the host as
# /dev/ttyACM0 (console=ttyGS0) even if userspace never starts.
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_F_FS=y

# stage 1 peripherals (all read-only or self-contained)
CONFIG_BATTERY_BQ27XXX_I2C=y
CONFIG_CHARGER_BQ24190=y
CONFIG_EXTCON_USBC_TUSB320=m
CONFIG_SENSORS_TMP103=m
CONFIG_BMI160_I2C=m
CONFIG_CM3232=m
CONFIG_AK8975=m
CONFIG_LEDS_KTD202X=m
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_BRCMUTIL=y
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
# pwrseq_simple with one reset-gpios goes through the reset framework's reset-gpio
# device; as a module it never loads and sdio-pwrseq defers forever
CONFIG_RESET_GPIO=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_BCM=y
# PowerVR GX6250 (render-only DRM device); built in because the initramfs has no modules
CONFIG_DRM_POWERVR=y

# no voltage scaling until the MT8176 OPPs and the regulator wiring are checked
# CONFIG_ARM_MEDIATEK_CPUFREQ is not set

# CPU idle needs working PSCI CPU_SUSPEND
# CONFIG_ARM_PSCI_CPUIDLE is not set

# Size (28 MB LK limit): drop the other SoC platforms that defconfig builds in.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_GOOGLE is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
# Size: features this tablet does not use (KVM stays: the kernel is entered at EL2)
# CONFIG_XEN is not set
# CONFIG_ACPI is not set
# CONFIG_NUMA is not set
# CONFIG_HIBERNATION is not set

# The stock LK keeps only the first 99 characters of the boot image command line, which
# silently dropped maxcpus=1, the *_ignore_unused flags and more in the first spike
# boots. Build the whole command line in and ignore the bootloader's (initrd and memory
# still come from the device tree LK passes).
CONFIG_CMDLINE="powervr.exp_hw_support=1 printk.devkmsg=on console=ttyGS0 console=tty0 mem=2G cma=128M clk_ignore_unused pd_ignore_unused regulator_ignore_unused loglevel=8 panic=5 oops=panic softlockup_panic=1 fbcon=font:TER16x32 initcall_blacklist=sysfb_init"
CONFIG_CMDLINE_FORCE=y

# A boot that stalls before init (2026-11-22: kernel alive, init never ran) must name the
# stuck task and reboot itself: hung-task detector with panic, soft-lockup detector.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_WQ_WATCHDOG=y

# Display: mediatek-drm with the dual-link DSI panel. The DTS drops the GCE mailbox from
# mmsys, so register updates are written directly (no CMDQ thread).
# MTK_MMSYS can only be built in if CMDQ is built in too (or off)
CONFIG_MTK_CMDQ=y
CONFIG_MTK_MMSYS=y
CONFIG_DRM_MEDIATEK=y
# CONFIG_DRM_MEDIATEK_DP is not set
# CONFIG_DRM_MEDIATEK_HDMI is not set
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_NOVATEK_NT35523=y
CONFIG_REGULATOR_TPS65132=y
CONFIG_BACKLIGHT_LP855X=y

# Touchscreen (FocalTech FT5x46 at i2c0 0x38)
CONFIG_TOUCHSCREEN_EDT_FT5X06=y
